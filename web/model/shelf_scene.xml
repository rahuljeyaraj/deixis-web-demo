    </body>
    <body name="pen" pos="0.4000 -0.1750 0.0890">
      <freejoint name="pen"/>
      <geom name="pen" type="box" size="0.0550 0.0080 0.0080" mass="0.008" rgba="0.20 0.38 0.70 1" class="thing"/>
    </body>

    <!-- the front row -->
    <body name="mug_1" pos="0.3000 0.1750 0.0410">
      <freejoint name="mug_1"/>
      <geom name="mug_1" type="cylinder" size="0.0320 0.0400" mass="0.03" rgba="0.20 0.38 0.70 1" class="thing"/>
    </body>
    <body name="mug_2" pos="0.3000 0.1050 0.0410">
      <freejoint name="mug_2"/>
