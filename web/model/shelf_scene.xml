    </body>

  </worldbody>

  <!-- The arms' resting pose (HOME in web/src/sim/arm.ts), tucked up clear of the
       shelf. MuJoCo's default pose lies flat along +X, straight through the front
       row. Order: the two arms' joints as attached, then every thing's freejoint
       (7 numbers each: position then quaternion), left as the bodies were placed. -->
  <keyframe>
    <key name="home" qpos="0 -1.45 0.75 1.45 0 0.2 0 -1.45 0.75 1.45 0 0.2 0.4000 0.1750 0.1160 1 0 0 0 0.4000 0.1050 0.1160 1 0 0 0 0.4000 0.0350 0.1160 1 0 0 0 0.4000 -0.0350 0.1160 1 0 0 0 0.4000 -0.1050 0.0860 1 0 0 0 0.4000 -0.1750 0.0890 1 0 0 0 0.3000 0.1750 0.0410 1 0 0 0 0.3000 0.1050 0.0410 1 0 0 0 0.3000 0.0350 0.0190 1 0 0 0 0.3000 -0.0350 0.0070 1 0 0 0 0.3000 -0.1050 0.0110 1 0 0 0 0.3000 -0.1750 0.0090 1 0 0 0"/>
  </keyframe>

  <!-- One weld per gripper. The page points each at whatever that arm is holding
       (eq_obj2id) and sets the relative pose (eq_data). The targets below are only
       a starting point so the model compiles. -->
  <equality>
    <weld name="left_grip" body1="left_gripper" body2="bottle_1"/>
    <weld name="right_grip" body1="right_gripper" body2="bottle_2"/>
  </equality>
</mujoco>
