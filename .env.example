# Copy to .env and fill in. Never commit .env.
# Nebius Token Factory key, for Nemotron (the server only; never sent to the browser).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_MODEL=nvidia/Nemotron-3_5-Lightning
# How the server reaches the deixis core: mcp (default) or direct.
DEIXIS_MODE=mcp
# Parakeet (speech to words): where the sherpa-onnx export lives. Download it with
# `uv run python scripts/fetch_models.py`, or link another copy into .cache/models.
# ASR_MODELS_DIR=C:\work\deixis-doodle\.cache\models
# ASR_WORKERS=2
# ASR_THREADS=4
# How much of our key each visitor may use; past it, Nemotron is off and the robot says it cannot answer.
# CAP_VISITOR_PER_DAY=500
# CAP_ADDRESS_PER_DAY=500
# CAP_TOTAL_PER_DAY=2000      # 0: simple mode for everyone (handy to see the banner)
# BURST_S=1.5                 # one command per visitor this often (an address: a third)
# Hosted behind a proxy (the Space, or Caddy): how many proxies, so the visitor's address is
# read from X-Forwarded-For. 0 when the browser talks to this server directly.
# PROXY_HOPS=0
